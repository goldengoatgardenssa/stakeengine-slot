{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/demo/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*\\.(js|css|png|jpg|jpeg|gif|svg|ico|json|mp3|wav|ogg|zst|csv))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
