{
  "cleanUrls": true,
  "routes": [
    { "src": "/demo", "dest": "/demo/index.html" },
    { "src": "/demo/(.*)", "dest": "/demo/$1" },
    { "src": "/images/(.*)", "dest": "/public/images/$1", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "src": "/sounds/(.*)", "dest": "/public/sounds/$1", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "src": "/style.css", "dest": "/demo/style.css", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "src": "/demo.js", "dest": "/demo/demo.js", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } }
  ],
  "buildCommand": "echo 'No build step needed for static demo'",
  "installCommand": "echo 'No install step needed'",
  "framework": "static"
}